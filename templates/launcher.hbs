<div class="efx-ui efx-ui-compact">
  <div class="efx-bg" aria-hidden="true">
    <div class="bg-glow"></div>
    <div class="bg-sigil-wrap">
      <svg class="bg-sigil" viewBox="0 0 400 400" aria-hidden="true">
        <defs><path id="efxRing" d="M200,200 m-176,0 a176,176 0 1,1 352,0 a176,176 0 1,1 -352,0"/></defs>
        <g fill="none" stroke="currentColor">
          <circle cx="200" cy="200" r="194" stroke-width="1.5"/>
          <circle cx="200" cy="200" r="158" stroke-width="1" stroke-dasharray="2 6"/>
          <circle cx="200" cy="200" r="150" stroke-width="1.2"/>
          <path stroke-width="1.2" d="M350,200 L93.9,306.1 L200,50 L306.1,306.1 L50,200 L306.1,93.9 L200,350 L93.9,93.9 Z"/>
          <circle cx="200" cy="200" r="64" stroke-width="1"/>
          <circle cx="200" cy="200" r="28" stroke-width="1.4"/>
        </g>
        <text fill="currentColor" font-size="12" letter-spacing="5" font-family="serif"><textPath href="#efxRing">MEMENTO MORI · FORTUNA FAVET · SANGUIS ET FLAMMA · ALEA IACTA EST ·</textPath></text>
      </svg>
    </div>
    <div class="bg-motes"></div>
    <div class="bg-vignette"></div>
  </div>

  <header class="efx-compact-head">
    <div class="efx-compact-mark">✦</div>
    <div>
      <h1>Encounter</h1>
      <p>Encounter control</p>
    </div>
    <div class="efx-compact-status">GM</div>
  </header>

  <div class="efx-compact-body">
    <label class="efx-field">
      <span>Scene</span>
      <select name="sceneId" required>
        <option value="" disabled selected>Select Scene</option>
        {{#each scenes}}
          <option value="{{id}}">{{name}}{{#if active}} — Active{{/if}}</option>
        {{else}}
          <option value="" disabled>No scenes found</option>
        {{/each}}
      </select>
    </label>

    <div class="efx-field">
      <span>Style</span>
      <div class="efx-style-row" role="radiogroup" aria-label="Encounter Style">
        {{#each styles}}
          <label class="efx-style-mini efx-style-mini-{{id}}" title="{{desc}}">
            <input type="radio" name="style" value="{{id}}" {{#if checked}}checked{{/if}}>
            <span class="efx-mini-art"><i></i><i></i><b></b></span>
            <span class="efx-mini-name">{{label}}</span>
          </label>
        {{/each}}
      </div>
    </div>

    <div class="efx-compact-bottom">
      <div class="efx-compact-options">
        <label class="efx-mini-toggle" title="Add hostile tokens from the destination scene to the combat">
          <input type="checkbox" name="hostile" checked>
          <span class="sw"></span>
          <span>Hostiles</span>
        </label>
        <div class="efx-party-count" title="Active player characters selected for the encounter">
          <span class="icon">♟</span>
          <span class="count">{{actors.length}}</span>
          <span>Players</span>
        </div>
      </div>

      <div class="efx-actor-strip" aria-label="Party">
        {{#each actors}}
          <label class="efx-actor-mini" title="{{name}}">
            <input type="checkbox" name="actor" value="{{id}}" {{#if checked}}checked{{/if}}>
            <img src="{{img}}" alt="{{name}}">
            <span>{{name}}</span>
          </label>
        {{/each}}
      </div>
    </div>
  </div>

  <footer class="efx-compact-foot">
    <button type="button" class="efx-ghost efx-preview-btn" data-action="preview">Preview</button>
    <button type="submit" class="efx-begin"><span>Start Encounter</span></button>
  </footer>
</div>
